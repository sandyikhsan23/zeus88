# Salin ke .env dan isi.

# PostgreSQL (produksi). Untuk Neon/Supabase pakai koneksi POOLED di sini,
# dan koneksi DIRECT di DIRECT_URL (dipakai saat migrate).
DATABASE_URL="postgresql://user:pass@host:5432/zeus88?sslmode=require"
DIRECT_URL="postgresql://user:pass@host:5432/zeus88?sslmode=require"

# Lokal tanpa Postgres: DATABASE_URL="file:./dev.db" (dan ganti provider ke sqlite)

# Kunci penandatangan session cookie — `openssl rand -base64 32`
AUTH_SECRET="ganti-dengan-string-acak-panjang"
